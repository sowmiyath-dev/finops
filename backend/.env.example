DATABASE_URL=postgresql+asyncpg://finops:password@db:5432/finops_db
# Optional: separate RDS instance for Azure data (recommended for performance)
# If not set, Azure data uses the same DB as AWS
AZURE_DATABASE_URL=postgresql+asyncpg://finops:password@azure-db:5432/finops_azure_db
SECRET_KEY=change-me-to-a-long-random-string
FERNET_KEY=change-me-run-python-cryptography-fernet-generate-key
ADMIN_EMAIL=admin@yourcompany.com
PORTAL_ACCOUNT_ID=123456789012
